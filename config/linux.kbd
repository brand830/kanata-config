;; ============================================================
;; Kanata - configuracion para LINUX (Ubuntu)
;; Se instala con: linux/instalar.sh
;; Las capas estan en comun.kbd (compartidas con Windows).
;; ============================================================

(defcfg
  ;; En Linux no existe el problema de las teclas de simbolos de Windows,
  ;; asi que Kanata puede procesar todas las teclas.
  process-unmapped-keys yes
  ;; Solo el Redragon Fizz Pro (Linux lo reconoce como "BY Tech Gaming Keyboard").
  ;; El teclado de la laptop ("AT Translated Set 2 keyboard") queda normal.
  ;; Para ver los nombres: grep Name= /proc/bus/input/devices
  linux-dev-names-include ("BY Tech Gaming Keyboard")
  ;; Si el Redragon no esta conectado al arrancar, Kanata espera en vez de fallar
  linux-continue-if-no-devs-found yes
  ;; Mouse: diagonales suaves y mantener la velocidad al cambiar de direccion
  movemouse-smooth-diagonals yes
  movemouse-inherit-accel-state yes
)

(defalias
  ;; Recorte de pantalla de Ubuntu (GNOME abre su herramienta de captura con Impr Pant)
  recorte prnt
)

(include comun.kbd)
